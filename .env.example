# Kopier denne fil til .env og udfyld selv. Del ALDRIG noeglerne med nogen.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ANTHROPIC_API_KEY=

# Valgfrit (standardvaerdier i bot.py). Paa GitHub: Settings > Secrets and variables > Actions > Variables
# MONTHLY_BUDGET_USD=7.50        # haard graense for AI-forbrug per maaned
# MAX_AI_ROUNDS_PER_DAY=10       # max antal AI-vurderinger per doegn
# RISK_PER_TRADE_PCT=0.005       # tab ved stop = 0,5 % af kontoen ved fuld conviction
# MAX_POSITION_PCT=0.15          # haardt loft paa positionsstoerrelse
# RESET_HALT=1                   # saet midlertidigt for at starte igen efter drawdown-HALT

# Hvilke coins botten handler (kommasepareret)
# COINS=BTC/USD,ETH/USD,SOL/USD
# MAX_TOTAL_EXPOSURE_PCT=0.40
